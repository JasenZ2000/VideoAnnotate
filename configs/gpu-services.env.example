# Unified GPU service
GPU_SERVICE_HOST=0.0.0.0
GPU_SERVICE_PORT=9010

# SAM3.1 job runtime. SAM31_PYTHON can point to the separate ComfyUI venv.
SAM31_CACHE_DIR=/data/annotation-cache/sam31
SAM31_COMFY_ROOT=/opt/ComfyUI
SAM31_CHECKPOINT=/models/sam3.1_multiplex_fp16.safetensors
SAM31_PYTHON=/opt/venvs/sam31-comfy/bin/python
SAM31_RUNNER=/srv/video-annotation-workflow/gpu_services/sam31_track.py
SAM31_DEVICES=cuda:0,cuda:1
SAM31_DTYPE=fp16
SAM31_ALLOWED_ROOTS=/data/annotation-transfer/sam31/videos

# LocateAnything job runtime. The external root must contain locateanything_worker.py.
LOCATEANYTHING_ROOT=/opt/LocateAnything
LOCANY_CACHE_DIR=/data/annotation-cache/locateanything
LOCANY_MODEL=nvidia/LocateAnything-3B
LOCANY_DEVICES=cuda:0,cuda:1
LOCANY_DTYPE=bf16
LOCANY_KEEP_MODEL_LOADED=1
LOCANY_BATCH_SIZE=4
LOCANY_BATCH_ATTN=la_flash
LOCANY_VISION_ATTN=auto
LOCANY_BATCH_SCHEDULER=pipeline
LOCANY_BATCH_GROUP_SIZE=0
LOCANY_STRICT_ATTN=1
LOCANY_MIN_EXPECTED_FPS=0.5
# LocateAnything 可读取的视频文件和图片目录都必须位于这些根目录中。
LOCANY_ALLOWED_ROOTS=/data/annotation-transfer/locateanything
